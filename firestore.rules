rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'WB00Y17z2mYEGm6iofyAVX1Gh863';
    }

    function isReservedItem(orderId, item) {
      let productPath = /databases/$(database)/documents/productos/$(item.productId);
      let productBefore = get(productPath);
      let productAfter = getAfter(productPath);
      return item is map
        && item.keys().hasOnly(['productId', 'nombre', 'cantidad', 'precioUnitario', 'subtotal'])
        && item.productId is string
        && item.productId.size() > 0
        && item.cantidad is int
        && item.cantidad > 0
        && exists(productPath)
        && existsAfter(productPath)
        && productBefore.data.activo == true
        && item.nombre == productBefore.data.nombre
        && item.precioUnitario == productBefore.data.precio
        && item.subtotal == item.precioUnitario * item.cantidad
        && productAfter.data.ultimaReservaId == orderId
        && productAfter.data.stock == productBefore.data.stock - item.cantidad;
    }

    function allItemsReserved(orderId, items) {
      return items is list
        && items.size() > 0
        && items.size() <= 8
        && isReservedItem(orderId, items[0])
        && (items.size() < 2 || isReservedItem(orderId, items[1]))
        && (items.size() < 3 || isReservedItem(orderId, items[2]))
        && (items.size() < 4 || isReservedItem(orderId, items[3]))
        && (items.size() < 5 || isReservedItem(orderId, items[4]))
        && (items.size() < 6 || isReservedItem(orderId, items[5]))
        && (items.size() < 7 || isReservedItem(orderId, items[6]))
        && (items.size() < 8 || isReservedItem(orderId, items[7]));
    }

    function isValidNewOrder(orderId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id', 'cliente', 'entrega', 'productos', 'subtotal', 'total',
          'metodoPago', 'estado', 'createdAt'
        ])
        && data.keys().hasAll([
          'id', 'cliente', 'entrega', 'productos', 'subtotal', 'total',
          'metodoPago', 'estado', 'createdAt'
        ])
        && data.id == orderId
        && data.estado == 'pendiente'
        && data.createdAt is string
        && data.metodoPago in ['transferencia', 'efectivo']
        && data.cliente is map
        && data.cliente.nombre is string
        && data.cliente.nombre.size() > 0
        && data.cliente.apellido is string
        && data.cliente.apellido.size() > 0
        && data.cliente.telefono is string
        && data.cliente.telefono.size() > 0
        && data.cliente.email is string
        && data.entrega is map
        && data.entrega.tipo in ['envio', 'retiro']
        && (data.entrega.tipo == 'retiro'
          || (data.entrega.direccion is string
            && data.entrega.direccion.size() > 0
            && data.entrega.localidad is string
            && data.entrega.localidad.size() > 0))
        && data.subtotal is number
        && data.total == data.subtotal
        && allItemsReserved(orderId, data.productos);
    }

    function matchesOrderItem(orderData, productId, quantity, index) {
      return orderData.productos.size() > index
        && orderData.productos[index].productId == productId
        && orderData.productos[index].cantidad == quantity
        && orderData.productos[index].precioUnitario == resource.data.precio;
    }

    function isOrderItem(orderData, productId, quantity) {
      return matchesOrderItem(orderData, productId, quantity, 0)
        || matchesOrderItem(orderData, productId, quantity, 1)
        || matchesOrderItem(orderData, productId, quantity, 2)
        || matchesOrderItem(orderData, productId, quantity, 3)
        || matchesOrderItem(orderData, productId, quantity, 4)
        || matchesOrderItem(orderData, productId, quantity, 5)
        || matchesOrderItem(orderData, productId, quantity, 6)
        || matchesOrderItem(orderData, productId, quantity, 7);
    }

    function isValidStockReservation(productId) {
      let orderId = request.resource.data.ultimaReservaId;
      let orderPath = /databases/$(database)/documents/ordenes/$(orderId);
      let orderAfter = getAfter(orderPath);
      return orderId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'ultimaReservaId'])
        && resource.data.stock is number
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && existsAfter(orderPath)
        && !exists(orderPath)
        && orderAfter.data.id == orderId
        && orderAfter.data.estado == 'pendiente'
        && orderAfter.data.productos is list
        && isOrderItem(
          orderAfter.data,
          productId,
          resource.data.stock - request.resource.data.stock
        );
    }

    match /productos/{productId} {
      allow read: if isAdmin() || resource.data.activo == true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidStockReservation(productId);
    }

    match /categorias/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ordenes/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidNewOrder(orderId);
      allow delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado in ['pendiente', 'confirmada', 'enviada', 'entregada', 'cancelada'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}